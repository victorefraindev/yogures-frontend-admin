# Supabase — proyecto de auth y storage del panel admin.
# Copiá este archivo a `.env` y completá con los valores de tu proyecto
# (Dashboard → Project Settings → API).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API del backend Go (rutas /api/admin y /api/products).
PUBLIC_API_URL=http://localhost:8080